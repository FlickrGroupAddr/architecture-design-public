          <mxGeometry x="975" y="285" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-worker" value="Internal FGA group-submission worker — Cloud Run&#xa;&#xa;database-fenced claims&#xa;fresh membership + moderation reads&#xa;add-only Flickr pool writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="430" width="320" height="165" as="geometry" />
        </mxCell>
