        <mxCell id="p1-workstation-note" value="Routine photo work stays in the FGA LrC plug-in. The browser is limited to private owner administration and credential transfer." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="650" width="330" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p1-edge" value="FGA HTTPS edge&#xa;Cloud DNS + global external Application Load Balancer&#xa;managed certificate; HTTPS only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="145" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p1-web" value="FGA API backend — Cloud Run candidate&#xa;&#xa;FGA HTTPS/API handlers&#xa;Google Login Endpoint + JWKS cache&#xa;FGA administrative control plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="285" width="285" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p1-tasks" value="Cloud Tasks&#xa;best-effort partition hints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="285" width="145" height="80" as="geometry" />
