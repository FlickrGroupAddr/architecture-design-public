          <mxGeometry x="800" y="680" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-worker-note" value="Other logical work (album, group refresh, replacement reconciliation) remains governed by its scoped contract; exact production runtime placement is implementation work." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="780" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p1-flickr" value="Flickr documented APIs&#xa;&#xa;Upload API — PNG/JPEG bytes&#xa;REST reads and OAuth 1.0a&#xa;photosets create/add&#xa;groups.pools.add (add only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="155" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="p1-google" value="Google Identity Services&#xa;Sign in with Google&#xa;Google-signed ID token + current JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="470" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-external-note" value="Flickr remains authoritative for photo ownership, visibility, album membership, group membership, moderation status, and API outcomes. Google proves only the Google Account; the FGA session and administrative allowlist remain FGA boundaries." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="655" width="330" height="130" as="geometry" />
