  <diagram id="fga-fail-polite-path" name="Fail-polite group add">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="Fail-polite Flickr group-add path" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-authority" value="Authority: Derived visual — ADR 0007, plugin-service-contract.md, and worker-persistence-scheduler-contract.md control. The photo/group permanent block is the safety boundary; the client cannot bypass it." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4d4d4d;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="58" width="1540" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p2-claim-lane" value="1 — Durable claim and guards" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="105" width="350" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p2-membership-lane" value="2 — Current membership" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="105" width="350" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p2-preflight-lane" value="3 — Fresh moderation preflight and add" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="105" width="410" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p2-result-lane" value="4 — Durable result" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="105" width="380" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p2-trigger" value="Cloud Tasks hint or minutely database due sweep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-claim" value="FGA group-submission worker claims the FIFO head with an expiring database-clock lease and fencing generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="285" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2-guards" value="Hard guards in the FGA database&#xa;&#xa;• no permanent submission_blocks row&#xa;• linked-user and deployment write gates enabled&#xa;• valid lease still held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-capacity" value="Reserve global Flickr rate-limit capacity for membership GET + moderation GET + possible add POST before the attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="610" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-contexts" value="Fresh documented&#xa;flickr.photos.getAllContexts&#xa;for the exact photo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="165" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-context-decision" value="Validate the complete response. Is the exact target group present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="455" y="315" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-present" value="Present → terminal added&#xa;No getInfo. No add POST." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="135" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-unavailable" value="Unavailable or incomplete → safe-read retry&#xa;No getInfo. No add POST." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="500" width="135" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-absent" value="Complete + absent → continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="465" y="650" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-getinfo" value="Fresh documented&#xa;flickr.groups.getInfo&#xa;for the exact group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="155" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2-record" value="Durably record interpretable ispoolmoderated value and response-receipt time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="285" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-freshness" value="Recheck write-gate revisions and monotonic age&#xa;&#xa;Dispatch must begin &lt; 1,000 ms after getInfo response receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="410" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-marker" value="Commit immutable dispatch_started marker while the Flickr POST still has not begun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="555" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-add" value="Immediately next Flickr API operation:&#xa;flickr.groups.pools.add" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="810" y="680" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2-classify" value="Classify the complete documented result — or the absence of one — and commit atomically with lease-fenced history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="150" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-added" value="Success or already in pool&#xa;→ added" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
