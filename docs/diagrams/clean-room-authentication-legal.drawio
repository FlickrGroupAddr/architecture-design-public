        <mxCell id="browser-session-flow" value="&lt;div style=&quot;font-size:16px;border-bottom:1.5px solid #1A1A1A;display:inline-block;padding-bottom:3px&quot;&gt;&lt;b&gt;Authentication Flow&lt;/b&gt;&lt;/div&gt;&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;margin-top:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;User opens FGA.com&lt;br&gt;in Browser.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Browser resolves FGA.com.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Browser retrieves landing&lt;br&gt;page static assets.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;User clicks Login.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Browser follows Google&lt;br&gt;sign-in redirect.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Google redirect UX:&lt;br&gt;Browser POSTs credential +&lt;br&gt;CSRF token to the FGA&lt;br&gt;Google Login Endpoint.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Login Endpoint verifies CSRF:&lt;br&gt;POST-cookie g_csrf_token ==&lt;br&gt;request-body g_csrf_token.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Login Endpoint reads current&lt;br&gt;Google JWKS from FGA cache.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Login Endpoint performs&lt;br&gt;current Google-required JWT&lt;br&gt;validation: trusted alg/key,&lt;br&gt;signature, iss, aud, and&lt;br&gt;time claims.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Login Endpoint generates&lt;br&gt;256-bit opaque token with&lt;br&gt;CSPRNG.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Endpoint maps (iss, sub) to&lt;br&gt;fgaUserId; atomically stores&lt;br&gt;SHA2-256(token) session +&lt;br&gt;sanitized login audit.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 6px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:6px;font-size:14px&quot;&gt;Login Endpoint sets&lt;br&gt;__Host-… cookie: Secure,&lt;br&gt;HttpOnly, Path=/,&lt;br&gt;SameSite=Strict, no Domain,&lt;br&gt;Max-Age=86400.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#003087;strokeWidth=1.5;spacingLeft=10;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="90" width="259" height="690" as="geometry" />
        </mxCell>
        <mxCell id="browser-session-authority" value="Authority: Normative happy-path interaction map (ADR 0039, ADR 0041); omitted failure/lifecycle/provider detail stays with controlling sources; session creation + login audit commit atomically; proactive JWKS refresh is outside the numbered login sequence; failed logins are audited when possible." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="31" y="794" width="1339" height="24" as="geometry" />
