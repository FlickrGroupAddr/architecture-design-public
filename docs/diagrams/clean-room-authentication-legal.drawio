          <mxGeometry x="183" y="659" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="plugin-code-transfer-flow" value="&lt;div style=&quot;font-size:16px;border-bottom:1.5px solid #1A1A1A;display:inline-block;padding-bottom:3px&quot;&gt;&lt;b&gt;Plugin Code Transfer&lt;/b&gt;&lt;/div&gt;&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;margin-top:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;User opens FGA User UI.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;FGA User UI JavaScript calls&lt;br&gt;GET /api/v001/plugin-codes.&lt;br&gt;Browser attaches the HttpOnly&lt;br&gt;__Host-… cookie; JavaScript&lt;br&gt;cannot read it.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;Plugin Code API computes&lt;br&gt;SHA2-256(session token).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;API requests session status&lt;br&gt;using that SHA2-256 digest.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;DB returns active, unexpired&lt;br&gt;session with fgaUserId.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;API queries owned Plugin Code&lt;br&gt;page by fgaUserId.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;Records return metadata page.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;API appends list-read audit.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;GET returns metadata;&lt;br&gt;JavaScript renders FGA User UI.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;User selects Create&lt;br&gt;Plugin Code.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;Browser POSTs&lt;br&gt;/api/v001/plugin-codes&lt;br&gt;with cookie, exact origin,&lt;br&gt;CSRF, and recent-auth proof.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;API generates 32 CSPRNG octets;&lt;br&gt;encodes canonical 13-group&lt;br&gt;Crockford Base32 Plugin Code.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;API atomically stores Plugin Code&lt;br&gt;record + create audit event;&lt;br&gt;never stores plaintext.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;API returns Plugin Code&lt;br&gt;exactly once with no-store.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;15&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;FGA User UI displays clear-text&lt;br&gt;canonical Plugin Code once.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;User copies and pastes into&lt;br&gt;clear-text FGA LrC plug-in input;&lt;br&gt;compares identical grouped values.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:18px;text-align:right;padding:0 8px 0px 0;vertical-align:top;font-size:12px&quot;&gt;&lt;b&gt;17&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:14px&quot;&gt;FGA LrC plug-in strictly validates,&lt;br&gt;stores in LrC Password Store;&lt;br&gt;clears field.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#003087;strokeWidth=1.5;spacingLeft=10;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1079" y="90" width="290" height="710" as="geometry" />
        </mxCell>
        <mxCell id="plugin-code-transfer-authority" value="Authority: Normative happy-path interaction map (ADR 0006, ADR 0039, ADR 0040, ADR 0041, ADR 0044); controlling sources own omitted failures, recent authentication, revocation, and later Bearer verification." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="31" y="794" width="1330" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
