          <mxGeometry x="2098.286" y="1761.035" width="54.857" height="50.824" as="geometry" />
        </mxCell>
        <mxCell id="publish-png-groups-flow" value="&lt;div style=&quot;font-size:40.659px;border-bottom:3.812px solid #1A1A1A;display:inline-block;padding-bottom:7.624px&quot;&gt;&lt;b&gt;Publish PNG + Groups&lt;/b&gt;&lt;/div&gt;&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;margin-top:30.494px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;User chooses Create Album…;&lt;br&gt;empty Album remains local-only.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;User adds one or more photos&lt;br&gt;to the Album.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;FGA LrC plugin retrieves&lt;br&gt;Plugin Code from LrC Password Store.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;GET /api/v001/installations/current;&lt;br&gt;Bearer Plugin Code.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;FGA API backend computes&lt;br&gt;SHA2-256; verifies active&lt;br&gt;lrc_plugin; returns Connected.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Plugin loads bounded writable-&lt;br&gt;group snapshot; Bearer attached.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;User selects zero or more&lt;br&gt;add-only groups per photo.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;User chooses Album Publish Now;&lt;br&gt;runtime supplies pending photos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;LrC rendering engine renders PNG;&lt;br&gt;FGA LrC plugin waits; size-preflights.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Plugin POSTs Bearer + allowlisted&lt;br&gt;upload metadata; no image bytes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;FGA API backend commits auth;&lt;br&gt;signed envelope: no-store, memory-only.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Plugin streams PNG directly to&lt;br&gt;Flickr Upload API.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Flickr returns photo ID; plugin&lt;br&gt;records recovery + catalog remote ID.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Plugin PUTs photo binding with&lt;br&gt;photo ID and Bearer.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;15&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;FGA API backend verifies via getInfo;&lt;br&gt;commits binding; returns ID + revision.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Plugin POSTs group IDs with&lt;br&gt;binding ID/rev + Bearer.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;17&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;FGA API backend atomically commits&lt;br&gt;group intents; 202 = durable handoff.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;18&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Worker calls fresh getAllContexts;&lt;br&gt;if absent, calls groups.getInfo;&lt;br&gt;records current moderation.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:49.371px;text-align:right;padding:0 21.943px 0px 0;vertical-align:top;font-size:30.494px&quot;&gt;&lt;b&gt;19&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-bottom:0px;font-size:33.671px&quot;&gt;Worker marks dispatch, starts&lt;br&gt;pools.add &amp;lt;1 s after getInfo;&lt;br&gt;commits result or polite block.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#003087;strokeWidth=3.812;spacingLeft=27.429;spacingTop=25.412;spacingRight=27.429;" vertex="1" parent="1">
          <mxGeometry x="2962.286" y="228.706" width="788.943" height="1753.412" as="geometry" />
        </mxCell>
        <mxCell id="publish-png-groups-authority" value="Authority: Normative happy-path interaction map (ADRs 0005–0007, 0041); one photo; zero groups skip 16–19; PNG direct to Flickr; 202 = durable handoff; group handling is add-only and fail-polite. Contracts own omitted Album, failure, and recovery detail." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=25.412;fontColor=#555555;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="85.029" y="2017.694" width="3672.686" height="60.988" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
