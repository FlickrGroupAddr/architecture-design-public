{
  "description": "Start and cleanly stop both required localswim boards and monitors.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\TDO-XPS15-2024\\.local\\bin\\uv.exe run --project C:\\Projects\\FGA\\architecture-design --frozen python C:\\Projects\\FGA\\architecture-design\\scripts\\start_localswim_session.py",
            "timeout": 120,
            "statusMessage": "Ensuring localswim boards and monitors",
            "additionalContextLimit": 250
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\TDO-XPS15-2024\\.local\\bin\\uv.exe run --project C:\\Projects\\FGA\\architecture-design --frozen python C:\\Projects\\FGA\\architecture-design\\scripts\\trigger_localswim_shutdown.py",
            "timeout": 3,
            "statusMessage": "Starting graceful localswim shutdown"
          }
        ]
      }
    ]
  }
}
